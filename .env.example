# Copy this file to .env and adjust if your API runs somewhere other than localhost.
#   cp .env.example .env

VITE_API_URL=http://localhost:5050/api

# Google sign-in: the Web client ID from Google Cloud Console → Google Auth Platform → Clients.
# Must also be listed in the backend's GOOGLE_CLIENT_IDS. Leave blank to hide the Google button.
VITE_GOOGLE_CLIENT_ID=
